# Copier ce fichier vers .env si la configuration locale est absente.
# Ne jamais renseigner de vraies cles dans ce fichier exemple.
# Cle commune au scoring et a la recherche web.
OPENROUTER_API_KEY=

# Modele de scoring : chat JSON ou Jev Decisions (ex. ~typesafe/jev-latest).
OPENROUTER_SCORING_MODEL=

# Modele chat d'extraction des documents, et de recherche web optionnelle.
OPENROUTER_WEB_MODEL=
